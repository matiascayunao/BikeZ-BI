            <component
              refId="Package\Dim_Tiempo\Origen Dim_Tiempo"
              componentClassID="Microsoft.OLEDBSource"
              contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
              description="OLE DB Source"
              name="Origen Dim_Tiempo"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">WITH Limites AS (
    SELECT
        CAST(MIN(Fecha) AS DATE) AS FechaInicio,
        CAST(MAX(FechaEnvio) AS DATE) AS FechaFin
    FROM dbo.Ventas
),
Calendario AS (
    SELECT FechaInicio AS Fecha, FechaFin
    FROM Limites

    UNION ALL

    SELECT DATEADD(DAY, 1, Fecha), FechaFin
    FROM Calendario
    WHERE Fecha &lt; FechaFin
)
SELECT
    CONVERT(INT, CONVERT(CHAR(8), Fecha, 112)) AS FechaKey,
    Fecha,
    CAST(DAY(Fecha) AS TINYINT) AS Dia,
    CAST(MONTH(Fecha) AS TINYINT) AS Mes,
    CAST(DATEPART(QUARTER, Fecha) AS TINYINT) AS Trimestre,
    CAST(YEAR(Fecha) AS SMALLINT) AS Anio,
    CASE DATEDIFF(DAY, '19000101', Fecha) % 7
        WHEN 0 THEN N'Lunes'
        WHEN 1 THEN N'Martes'
        WHEN 2 THEN N'Miercoles'
        WHEN 3 THEN N'Jueves'
        WHEN 4 THEN N'Viernes'
        WHEN 5 THEN N'Sabado'
        WHEN 6 THEN N'Domingo'
    END AS DiaSemana,
    CAST(
        CASE
            WHEN DATEDIFF(DAY, '19000101', Fecha) % 7 IN (5, 6)
            THEN 1
            ELSE 0
        END AS BIT
    ) AS EsFinDeSemana
FROM Calendario
OPTION (MAXRECURSION 0);</property>
