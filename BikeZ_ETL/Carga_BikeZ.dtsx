                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT
    T.TerritorioID,
    T.Territorio,
    P.Pais,
    T.Grupo,
    COUNT(A.AlmacenID) AS CantidadAlmacenes
FROM dbo.Territorios AS T
INNER JOIN dbo.Paises AS P
    ON T.PaisID = P.PaisID
LEFT JOIN dbo.Almacenes AS A
    ON T.TerritorioID = A.TerritorioID
GROUP BY
    T.TerritorioID,
    T.Territorio,
    P.Pais,
    T.Grupo;</property>
