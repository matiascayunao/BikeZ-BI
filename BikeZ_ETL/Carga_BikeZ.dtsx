            <component
              refId="Package\Fact_Detalle_Venta\Origen Fact_Detalle_Venta"
              componentClassID="Microsoft.OLEDBSource"
              contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
              description="OLE DB Source"
              name="Origen Fact_Detalle_Venta"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT
    D.DetalleVentaID,
    D.VentaID,

    CONVERT(INT, CONVERT(CHAR(8), V.Fecha, 112))
        AS FechaVentaKey,

    CASE
        WHEN V.FechaEnvio IS NULL THEN NULL
        ELSE CONVERT(INT, CONVERT(CHAR(8), V.FechaEnvio, 112))
    END AS FechaEnvioKey,

    C.ClienteKey,
    P.ProductoKey,

    ISNULL(E.EmpleadoKey, -1) AS EmpleadoKey,

    T.TerritorioKey,

    D.Cantidad,

    CAST(D.PrecioUnitario AS DECIMAL(19,4))
        AS PrecioUnitario,

    CAST(
        CAST(D.Cantidad AS DECIMAL(9,0))
        * CAST(D.PrecioUnitario AS DECIMAL(19,4))
        AS DECIMAL(29,4)
    ) AS MontoTotal

FROM dbo.DetalleVentas AS D

INNER JOIN dbo.Ventas AS V
    ON D.VentaID = V.VentaID

INNER JOIN BikeZDW.dbo.Dim_Cliente AS C
    ON V.ClienteID = C.ClienteID

INNER JOIN BikeZDW.dbo.Dim_Producto AS P
    ON D.ProductoID = P.ProductoID

LEFT JOIN BikeZDW.dbo.Dim_Empleado AS E
    ON V.VendedorID = E.EmpleadoID

INNER JOIN BikeZDW.dbo.Dim_Territorio AS T
    ON V.TerritorioID = T.TerritorioID;</property>
